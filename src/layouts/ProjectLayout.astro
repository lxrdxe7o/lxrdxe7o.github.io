---
import type { CollectionEntry } from 'astro:content';
import type { MediaManifest } from '../types/media';
import BaseLayout from './BaseLayout.astro';
import SvgLink from '../components/shared/SvgLink.astro';
import ProjectMedia from '../components/projects/ProjectMedia.astro';
import { PROJECT_CARDS } from '../runtime/rendering/scenes/ProjectCarouselScene';

interface Props {
  project: CollectionEntry<'projects'>;
  nextProject?: CollectionEntry<'projects'>;
  mediaManifest?: MediaManifest;
}

const { project, nextProject, mediaManifest } = Astro.props;
const cardData = PROJECT_CARDS.find((c) => c.slug === project.data.slug);
const projectColor = cardData?.color ?? '#ff3b38';
---

<BaseLayout
  title={`${project.data.title} — Ishraful Haque`}
  description={project.data.summary}
  canonical={`/projects/${project.data.slug}`}
  routeId={`project-${project.data.slug}`}
  frame="wide"
>
  <div
    data-view="project"
    class="ui-project"
    data-project={project.data.slug}
    style={`--accent-current: ${projectColor};`}
  >
    <!-- Top Return Header -->
    <div class="ui-project-header c-color">
      <div class="wrap">
        <SvgLink
          text="To index"
          href="/"
          dataTransition="work"
          dataSound=""
          dataSoundClick=""
        />
      </div>
    </div>

    <div class="wrap wrap--md">
      <div class="lg:grid grid-cols-24 gap-24">
        <div class="col-span-24 lg:col-span-20 lg:col-start-5 ui-project-content">
          <!-- Project Title -->
          <div class="ui-project-title">
            <h1 class="ts-2 c-color">
              <span>{project.data.title}</span>
            </h1>
          </div>

          <!-- Project Media Section -->
          {mediaManifest && (
            <div class="ui-project-media">
              <ProjectMedia manifest={mediaManifest} />
            </div>
          )}

          <!-- Project Metadata Facts -->
          <div class="ui-project-info">
            <div class="ui-project-info-grid">
              {project.data.type && (
                <div class="ui-project-info-item">
                  <h4>Category</h4>
                  <p>{project.data.type}</p>
                </div>
              )}
              {project.data.technologies?.length > 0 && (
                <div class="ui-project-info-item">
                  <h4>Technologies</h4>
                  <p>{project.data.technologies.join(', ')}</p>
                </div>
              )}
              {project.data.year && (
                <div class="ui-project-info-item">
                  <h4>Year</h4>
                  <p>{project.data.year}</p>
                </div>
              )}
              {project.data.repository && (
                <div class="ui-project-info-item">
                  <h4>Repository</h4>
                  <p>
                    <a href={project.data.repository} target="_blank" rel="noopener">
                      GitHub Source ↗
                    </a>
                  </p>
                </div>
              )}
              {project.data.url && (
                <div class="ui-project-info-item">
                  <h4>Live Website</h4>
                  <p>
                    <a href={project.data.url} target="_blank" rel="noopener">
                      Launch Project ↗
                    </a>
                  </p>
                </div>
              )}
            </div>
          </div>

          <!-- Narrative / Documentation Body -->
          <div class="ui-project-text ts-p">
            <slot />
          </div>

          <!-- Next Project Navigation -->
          {nextProject && (
            <div class="ui-project-footer">
              <SvgLink
                text={`Next project: ${nextProject.data.title}`}
                href={`/projects/${nextProject.data.slug}`}
                dataTransition="project"
                dataSound=""
                dataSoundClick=""
                reverse={true}
              />
            </div>
          )}
        </div>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ projectColor }}>
    document.documentElement.style.setProperty('--accent-current', projectColor);
  </script>
</BaseLayout>
