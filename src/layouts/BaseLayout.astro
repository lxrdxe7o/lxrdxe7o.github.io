---
import { ClientRouter } from 'astro:transitions';
import SiteHeader from '../components/shell/SiteHeader.astro';
import SiteFooter from '../components/shell/SiteFooter.astro';
import RouteFrame from '../components/shell/RouteFrame.astro';
import ExperienceCanvas from '../components/shell/ExperienceCanvas.astro';
import Loader from '../components/shell/Loader.astro';
import EntryGate from '../components/shell/EntryGate.astro';
import TransitionLayer from '../components/shell/TransitionLayer.astro';
import MuteControl from '../components/shell/MuteControl.astro';
import RuntimeFallback from '../components/shell/RuntimeFallback.astro';
import OfflineNotice from '../components/shell/OfflineNotice.astro';
import SiteIndex from '../components/shell/SiteIndex.astro';
import CornerFrame from '../components/shell/CornerFrame.astro';
import Seo from '../components/content/Seo.astro';
import type { StructuredDataBlock } from '../lib/seo/metadata';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import '../styles/utilities.css';
import '../styles/motion.css';
interface Props {
  title: string;
  description: string;
  canonical?: string;
  routeId: string;
  image?: string;
  /** Layout variant for the content inside `<main>`. Defaults to the standard content width. */
  frame?: 'default' | 'wide' | 'prose';
  structuredData?: readonly StructuredDataBlock[];
  publishedAt?: Date;
  updatedAt?: Date;
  /** Error pages get robots noindex and no canonical/OG URL. */
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  routeId,
  image,
  frame = 'default',
  structuredData = [],
  publishedAt,
  updatedAt,
  noindex = false,
} = Astro.props;
const seoPath = canonical ?? Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0a0a0b" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <Seo
        path={seoPath}
        {title}
        {description}
        image={image}
        structuredData={structuredData}
        publishedAt={publishedAt}
        updatedAt={updatedAt}
      />
    )}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/geist/Geist-Regular.woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/jetbrains-mono/JetBrainsMono-Regular.woff2"
      crossorigin="anonymous"
    />
    <ClientRouter />
    <style is:global>
      /* Persistent runtime controls sit above content, below the entry gate. */
      .runtime-controls {
        position: fixed;
        inset-block-start: var(--space-3);
        inset-inline-end: var(--space-3);
        z-index: var(--z-header);
        display: flex;
        gap: var(--space-2);
      }

      /* Scrolling is suspended only while a modal surface owns the page. */
      :root[data-scroll-locked] body {
        overflow: hidden;
      }
    </style>
  </head>
  <body id={routeId}>
    <CornerFrame />
    <div id="experience-runtime-root" data-runtime-root>
      <ExperienceCanvas />
      <TransitionLayer />
      <Loader />
      <EntryGate />
      <div class="runtime-controls">
        <MuteControl />
      </div>
      <OfflineNotice />
      <RuntimeFallback />
      <SiteIndex />
      <p
        class="u-visually-hidden"
        data-runtime-announcer
        role="status"
        aria-live="polite"
        transition:persist="runtime-announcer"
      ></p>
    </div>
    <SiteHeader />
    <main id="main-content" tabindex="-1">
      <RouteFrame variant={frame}>
        <slot />
      </RouteFrame>
    </main>
    <SiteFooter />    <script>
      import { getExperienceRuntime } from '../runtime/core/runtime-singleton';
      import { bootstrapExperience } from '../runtime/bootstrap';

      const root = document.querySelector<HTMLElement>('[data-runtime-root]');
      if (root) {
        const runtime = getExperienceRuntime();
        const syncPhase = () => {
          const snapshot = runtime.getSnapshot();
          root.dataset.runtimePhase = snapshot.phase;
          // The loader and gate overlays key their visibility off the root
          // element, so no-JS visitors never see either of them.
          document.documentElement.dataset.runtimePhase = snapshot.phase;
        };

        if (root.dataset.runtimeBound !== 'true') {
          root.dataset.runtimeBound = 'true';
          const unsubscribe = runtime.subscribe(syncPhase);
          runtime.registerTeardown(() => {
            unsubscribe();
            delete root.dataset.runtimeBound;
            delete root.dataset.runtimePhase;
            delete document.documentElement.dataset.runtimePhase;
          });
        }

        syncPhase();
        // Owns input, scroll, quality, assets, audio and navigation. The
        // renderer and the single animation loop belong to ExperienceCanvas.
        bootstrapExperience();
      }
    </script>
  </body>
</html>
