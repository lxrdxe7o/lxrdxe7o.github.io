---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getWriting } from '../lib/content/getWriting';

const articles = await getWriting();
---
<BaseLayout title="Blog" description="My Blog" routeId="blog">
  <h1>Blog</h1>
  {articles.length === 0 ? (
    <p>No articles published yet.</p>
  ) : (
    <ul>
      {articles.map((article) => (
        <li>
          <article>
            <h2>{article.data.title}</h2>
            <p>{article.data.description}</p>
            <time datetime={article.data.publishDate.toISOString()}>
              {article.data.publishDate.toISOString().slice(0, 10)}
            </time>
          </article>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
