---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import CodeBlock from '../../components/content/CodeBlock.astro';
import { getWriting } from '../../lib/content/getWriting';
import { filterRelatedEditorialEntries } from '../../data/editorial';

export async function getStaticPaths() {
  const entries = await getWriting({ includeDrafts: false });
  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

interface Props { entry: CollectionEntry<'writing'>; }
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const allEntries = await getWriting({ includeDrafts: false });
const relatedSource = allEntries.map((candidate) => ({
  slug: candidate.data.slug,
  draft: candidate.data.draft,
  tags: candidate.data.tags,
  title: candidate.data.title,
  description: candidate.data.description,
  date: candidate.data.publishDate,
  href: `/writing/${candidate.data.slug}`,
}));
const related = filterRelatedEditorialEntries(relatedSource, entry.data.slug, entry.data.tags);
---
<ArticleLayout
  kind="writing"
  title={entry.data.title}
  description={entry.data.description}
  date={entry.data.publishDate}
  updatedDate={entry.data.updatedDate}
  tags={entry.data.tags}
  slug={entry.data.slug}
  {headings}
  {related}
>
  <Content components={{ CodeBlock }} />
</ArticleLayout>
