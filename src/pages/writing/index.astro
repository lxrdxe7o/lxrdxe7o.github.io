---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleIndex from '../../components/content/ArticleIndex.astro';
import { getWriting } from '../../lib/content/getWriting';
const entries = (await getWriting({ includeDrafts: false })).map((entry) => ({
  slug: entry.data.slug,
  title: entry.data.title,
  description: entry.data.description,
  date: entry.data.publishDate,
  tags: entry.data.tags,
  href: `/writing/${entry.data.slug}`,
}));
---
<BaseLayout title="Writing — lxrdxe7o" description="Native long-form writing by Ishraful Haque" canonical="/writing" routeId="writing">
  <header class="page-heading"><p>Writing</p><h1>Writing</h1><p>Long-form articles published from approved local MDX source.</p></header>
  <ArticleIndex kind="writing" {entries} />
</BaseLayout>
<style>
  .page-heading { display: grid; gap: var(--space-4); min-block-size: min(52vh, 30rem); align-content: center; }
  .page-heading > p:first-child { color: var(--color-accent-text); font: var(--text-mono)/1.5 var(--font-family-mono); text-transform: uppercase; letter-spacing: var(--tracking-wide); }
  h1 { font-size: clamp(3rem, 10vw, 6rem); letter-spacing: -0.04em; }
  h1 + p { color: var(--color-fg-muted); font-size: var(--text-body-lg); }
</style>
