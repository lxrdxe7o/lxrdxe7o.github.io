---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroIdentity from '../components/shell/HeroIdentity.astro';
import HeroMeta from '../components/shell/HeroMeta.astro';
import WorkPrompt from '../components/shell/WorkPrompt.astro';
import { profileValue } from '../data/profile';
import { nowStatus } from '../data/now';
import { siteWebSiteData, sitePersonData } from '../lib/seo/metadata';
import { getProjects } from '../lib/content/getProjects';

const mark = profileValue('mark') ?? 'lxrdxe7o';
const title = profileValue('title') ?? 'Full-Stack Developer';
const name = profileValue('name') ?? 'Ishraful Haque';
const flagship = (await getProjects({ includeDrafts: false })).find(
  (project) => project.data.featured === 1,
);
---

<BaseLayout
  title="lxrdxe7o — Full-Stack Developer"
  description="Portfolio of Ishraful Haque (lxrdxe7o), a full-stack developer publishing independent software work."
  canonical="/"
  routeId="home"
  structuredData={[siteWebSiteData, sitePersonData]}
>
  <section class="home-hero" data-scroll-section="home-hero" aria-labelledby="home-identity">
    <HeroIdentity {mark} {title} {name} />
    <HeroMeta availabilityLabel={nowStatus.label} />
  </section>
  {flagship && <WorkPrompt title={flagship.data.title} slug={flagship.data.slug} summary={flagship.data.summary} />}
</BaseLayout>

<style>
  .home-hero {
    display: grid;
    gap: var(--space-8);
  }
</style>
