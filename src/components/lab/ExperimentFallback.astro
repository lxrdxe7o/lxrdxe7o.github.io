---
/**
 * Static fallback for a Lab experiment: shown whenever WebGL or a required
 * capability is unavailable, and rendered server-side so no-JS visitors get
 * a complete explanation too.
 */
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section class="experiment-fallback" data-experiment-fallback aria-labelledby="experiment-fallback-heading">
  <p class="experiment-fallback__label">Static view</p>
  <h2 id="experiment-fallback-heading">{title}</h2>
  <p>
    This experiment needs WebGL, which is unavailable in this browser or was
    disabled by a preference. Everything else on the site works normally.
  </p>
</section>

<style>
  .experiment-fallback {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-section);
    border-top: 1px solid var(--color-border);
  }
  .experiment-fallback__label {
    color: var(--color-accent-text);
    font: var(--text-mono)/1.5 var(--font-family-mono);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }
  h2 {
    max-inline-size: 22ch;
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    letter-spacing: -0.03em;
  }
  p {
    max-inline-size: 68ch;
    color: var(--color-fg-muted);
  }
</style>
