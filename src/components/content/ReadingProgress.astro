<div class="reading-progress" aria-hidden="true">
  <span data-reading-progress></span>
</div>

<script>
  const bindReadingProgress = () => {
    const bar = document.querySelector<HTMLElement>('[data-reading-progress]');
    const article = document.querySelector<HTMLElement>('[data-article-body]');
    if (!bar || !article || bar.dataset.bound === 'true') return;
    bar.dataset.bound = 'true';
    const update = () => {
      const start = article.offsetTop;
      const distance = Math.max(1, article.offsetHeight - window.innerHeight);
      const progress = Math.min(1, Math.max(0, (window.scrollY - start) / distance));
      bar.style.transform = `scaleX(${progress})`;
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
  };
  bindReadingProgress();
  document.addEventListener('astro:page-load', bindReadingProgress);
</script>

<style>
  .reading-progress { position: fixed; inset: 0 0 auto; z-index: calc(var(--z-header) + 1); block-size: 2px; pointer-events: none; }
  span { display: block; inline-size: 100%; block-size: 100%; background: var(--color-accent); transform: scaleX(0); transform-origin: left; }
  @media (prefers-reduced-motion: reduce), print { .reading-progress { display: none; } }
</style>
