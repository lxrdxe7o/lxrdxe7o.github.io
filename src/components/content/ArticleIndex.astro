---
interface ArticleListItem {
  slug: string;
  title: string;
  description?: string;
  date: Date;
  tags?: readonly string[];
  href: string;
}
interface Props { kind: 'writing' | 'notes'; entries: readonly ArticleListItem[]; }
const { kind, entries } = Astro.props;
const emptyText = kind === 'writing'
  ? 'No writing is published yet. New articles will appear here only when approved source material exists.'
  : 'No notes are published yet. This index will remain quiet rather than inventing entries.';
const formatter = new Intl.DateTimeFormat('en', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<section class="article-index" aria-labelledby="article-index-heading">
  <h2 id="article-index-heading">{kind === 'writing' ? 'Published articles' : 'Published notes'}</h2>
  {entries.length === 0 ? (
    <div class="article-index__empty"><p>{emptyText}</p><a href="/projects">Browse verified project work</a></div>
  ) : (
    <ol>
      {entries.map((entry) => (
        <li><article><a href={entry.href}><h3>{entry.title}</h3>{entry.description && <p>{entry.description}</p>}<time datetime={entry.date.toISOString()}>{formatter.format(entry.date)}</time>{entry.tags?.length && <span>{entry.tags.join(' · ')}</span>}</a></article></li>
      ))}
    </ol>
  )}
</section>

<style>
  .article-index { padding-block: var(--space-8) var(--space-section); border-top: 1px solid var(--color-border); }
  .article-index > h2 { font: var(--text-mono)/1.5 var(--font-family-mono); color: var(--color-fg-muted); text-transform: uppercase; letter-spacing: var(--tracking-wide); }
  ol { margin-top: var(--space-8); border-top: 1px solid var(--color-border); }
  li { margin: 0; border-bottom: 1px solid var(--color-border); }
  article a { display: grid; gap: var(--space-3); min-block-size: 9rem; padding-block: var(--space-6); text-decoration: none; }
  h3 { font-size: var(--text-h2); }
  article p { color: var(--color-fg-muted); }
  time, article span { color: var(--color-fg-muted); font: var(--text-mono)/1.5 var(--font-family-mono); }
  .article-index__empty { display: grid; gap: var(--space-6); max-inline-size: 65ch; margin-top: var(--space-12); padding-block: var(--space-8); }
  .article-index__empty p { color: var(--color-fg-muted); font-size: var(--text-body-lg); }
  .article-index__empty a { color: var(--color-accent-text); text-decoration: underline; text-underline-offset: .25em; }
</style>
