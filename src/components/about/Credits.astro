---
import { credits } from '../../data/profile';
---
{credits.length > 0 && (
  <section class="credits" aria-labelledby="credits-heading">
    <p>Production record</p>
    <h2 id="credits-heading">Credits</h2>
    <dl>
      {credits.map((credit) => (
        <div>
          <dt>{credit.category}</dt>
          <dd>{credit.href ? <a href={credit.href} target="_blank" rel="noopener noreferrer">{credit.name}<span aria-hidden="true"> ↗</span></a> : credit.name}<p>{credit.note}</p></dd>
        </div>
      ))}
    </dl>
  </section>
)}

<style>
  .credits { padding-block: var(--space-section); border-top: 1px solid var(--color-border); }
  .credits > p { color: var(--color-accent-text); font: var(--text-mono)/1.5 var(--font-family-mono); letter-spacing: var(--tracking-wide); text-transform: uppercase; }
  h2 { margin-top: var(--space-4); }
  dl { margin-top: var(--space-8); }
  dl > div { display: grid; grid-template-columns: minmax(7rem, .3fr) minmax(0, 1fr); gap: var(--space-4); padding-block: var(--space-5, 1.25rem); border-top: 1px solid var(--color-border); }
  dt { color: var(--color-fg-muted); font-family: var(--font-family-mono); font-size: var(--text-mono); }
  dd { margin: 0; }
  dd p { margin-top: var(--space-2); color: var(--color-fg-muted); }
  a { color: var(--color-accent-text); text-decoration: underline; text-underline-offset: .25em; }
</style>
