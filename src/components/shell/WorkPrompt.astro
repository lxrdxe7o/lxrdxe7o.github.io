---
/**
 * Direct path into selected work from the home route. Sparse and editorial:
 * one ranked project, one unmistakable link.
 */
interface Props {
  title: string;
  slug: string;
  summary: string;
}

const { title, slug, summary } = Astro.props;
---

<section class="work-prompt" data-scroll-section="work-prompt" aria-labelledby="work-prompt-heading">
  <p class="work-prompt__label">Selected work</p>
  <h2 id="work-prompt-heading">{title}</h2>
  <p class="work-prompt__summary">{summary}</p>
  <a class="work-prompt__link" href={`/projects/${slug}`}>
    Open case study<span aria-hidden="true"> →</span>
  </a>
</section>

<style>
  .work-prompt {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-section);
    border-top: 1px solid var(--color-border);
  }

  .work-prompt__label {
    color: var(--color-accent-text);
    font: var(--text-mono)/1.5 var(--font-family-mono);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  h2 {
    max-inline-size: 20ch;
    font-size: clamp(2rem, 6vw, 4rem);
    letter-spacing: -0.04em;
  }

  .work-prompt__summary {
    max-inline-size: 68ch;
    color: var(--color-fg-muted);
  }

  .work-prompt__link {
    justify-self: start;
    min-block-size: 2.75rem;
    padding: var(--space-3) var(--space-5);
    border: 1px solid var(--color-accent);
    color: var(--color-accent-text);
  }
</style>
