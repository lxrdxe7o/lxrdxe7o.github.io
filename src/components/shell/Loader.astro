---
/**
 * Real loading progress driven by `AssetManager` byte weights.
 *
 * Visibility is keyed off the runtime phase on the root element, so with
 * JavaScript disabled this overlay never renders and route content is
 * immediately readable.
 */
---

<div class="loader" data-loader data-loader-state="idle">
  <div class="preloader-progress">
    <svg class="preloader-progress-circles" width="462" height="462" viewBox="0 0 462 462" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle class="preloader-progress-outline" opacity="0.4" cx="231" cy="231" r="224" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="2 2"></circle>
      <circle class="preloader-progress-circle" data-loader-bar opacity="0.5" cx="231" cy="231" r="230" fill="none" stroke="currentColor" stroke-width="1"></circle>
    </svg>
    <div class="preloader-progress-text">
      <div class="preloader-progress-text-inner"><span data-loader-value>0</span>%</div>
    </div>
  </div>
</div>

<style>
  .loader {
    position: fixed;
    inset: 0;
    z-index: var(--z-loader, 90);
    display: none;
    place-items: center;
    background: var(--color-bg);
  }

  :global(:root[data-runtime-phase='booting']) .loader,
  :global(:root[data-runtime-phase='loading']) .loader,
  :global(:root[data-runtime-phase='entry-gate']) .loader {
    display: grid;
  }

  .preloader-progress {
    position: relative;
    width: min(462px, 90vw);
    height: min(462px, 90vw);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .preloader-progress-circles {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .preloader-progress-circle {
    stroke-dasharray: 1445;
    stroke-dashoffset: calc(1445 - (1445 * var(--loader-progress, 0)));
    transition: stroke-dashoffset 180ms linear;
    transform: rotate(-90deg);
    transform-origin: 50% 50%;
  }

  .preloader-progress-text {
    position: absolute;
    font-family: var(--font-mono);
    font-size: 1rem;
    color: var(--color-fg-muted);
  }

  /* Hide the text and progress circle when we reach entry-gate */
  :global(:root[data-runtime-phase='entry-gate']) .preloader-progress-text,
  :global(:root[data-runtime-phase='entry-gate']) .preloader-progress-circle {
    opacity: 0;
    transition: opacity 0.5s ease;
  }
</style>
