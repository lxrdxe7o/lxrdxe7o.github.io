---
/**
 * Sound and silent entry are equal, first-class choices presented only after
 * critical assets have actually finished loading. No audio is requested,
 * decoded or played before one of these buttons is pressed.
 *
 * The gate starts hidden, so a visitor without JavaScript is never blocked.
 */
---

<div
  class="entry-gate"
  data-entry-gate
  data-state="closed"
  role="dialog"
  aria-modal="true"
  aria-labelledby="entry-gate-title"
  aria-describedby="entry-gate-description"
  hidden
>
  <div class="entry-gate__actions">
    <button type="button" class="preloader-cta" data-entry="sound" data-sound="true">
      <span class="preloader-cta-text">
        <span class="preloader-cta-text-inner">
          <span class="preloader-cta-text-static">Enter</span>
          <span class="preloader-cta-text-hover">Enter</span>
        </span>
      </span>
    </button>
    <button type="button" class="preloader-cta-2" data-entry="silent" data-sound="false">
      Enter without sound
    </button>
  </div>
</div>

<style>
  .entry-gate {
    position: fixed;
    inset: 0;
    z-index: var(--z-entry-gate, 95);
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    pointer-events: none;
  }

  .entry-gate[hidden] {
    display: none !important;
  }

  .entry-gate__actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-6);
    pointer-events: auto;
  }

  button {
    background: transparent;
    border: none;
    color: var(--color-fg);
    cursor: pointer;
    font-family: var(--font-sans);
    padding: 0;
    display: block;
    outline: none;
  }

  .preloader-cta {
    font-size: clamp(2.5rem, 5vw, 4rem);
    letter-spacing: -0.04em;
    position: relative;
    text-transform: none;
  }

  .preloader-cta-text {
    display: block;
    overflow: hidden;
  }

  .preloader-cta-text-inner {
    position: relative;
    display: block;
  }

  .preloader-cta-text-static {
    display: block;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .preloader-cta-text-hover {
    position: absolute;
    left: 0;
    top: 0;
    transform: translateY(105%);
    opacity: 0;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    color: var(--color-accent);
  }

  .preloader-cta:hover .preloader-cta-text-static {
    transform: translateY(-105%);
    opacity: 0;
  }

  .preloader-cta:hover .preloader-cta-text-hover {
    transform: translateY(0);
    opacity: 1;
  }

  .preloader-cta-2 {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.5;
    transition: opacity 0.3s ease;
  }

  .preloader-cta-2:hover {
    opacity: 1;
  }
</style>
