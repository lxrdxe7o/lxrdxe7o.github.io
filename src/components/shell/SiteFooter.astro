---
import PrimaryNavigation from './PrimaryNavigation.astro';
---

<footer class="ui-footer">
  <div class="wrap">
    <div class="grid grid-cols-24 gap-24 items-center">
      <!-- Left side: Social Links -->
      <div class="col-span-12 lg:col-span-8">
        <ul class="flex items-center gap-24 ts-m">
          <li>
            <a
              class="social-a c-color"
              href="https://github.com/lxrdxe7o"
              target="_blank"
              rel="noopener"
              data-sound=""
              data-sound-click=""
            >
              <span>GitHub</span>
            </a>
          </li>
          <li>
            <a
              class="social-a c-color"
              href="https://twitter.com/lxrdxe7o"
              target="_blank"
              rel="noopener"
              data-sound=""
              data-sound-click=""
            >
              <span>Twitter</span>
            </a>
          </li>
          <li>
            <a
              class="social-a c-color"
              href="mailto:contact@lxrdxe7o.me"
              data-sound=""
              data-sound-click=""
            >
              <span>contact@lxrdxe7o.me</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Right side: Work / About Floating Navigation -->
      <div class="col-span-12 lg:col-span-6 lg:col-start-19 flex justify-between lg:justify-end">
        <PrimaryNavigation />
      </div>
    </div>
  </div>
</footer>
