---
interface Props {
  text?: string;
  href?: string;
  class?: string;
  target?: string;
  rel?: string;
  dataTransition?: string;
  dataSound?: string;
  dataSoundClick?: string;
  width?: number;
  height?: number;
}

const {
  text = 'View project',
  href,
  class: className = '',
  target,
  rel,
  dataTransition,
  dataSound = '',
  dataSoundClick = '',
  width = 133,
  height = 25,
} = Astro.props;

const Tag = href ? 'a' : 'button';
---

<Tag
  href={href}
  class={`c-button ${className}`}
  target={target}
  rel={rel}
  data-transition={dataTransition}
  data-sound={dataSound}
  data-sound-click={dataSoundClick}
>
  <span class="c-button-bg">
    <svg width={width} height={height} viewBox={`0 0 ${width} ${height}`}>
      <rect
        class="c-button-bg-hover"
        fill="none"
        stroke="currentColor"
        stroke-width="1"
        x="0"
        y="0"
        width={width}
        height={height - 2}
      ></rect>
      <rect
        class="c-button-bg-static"
        fill="none"
        stroke="currentColor"
        stroke-dasharray="2 2"
        stroke-width="1"
        x="0"
        y="0"
        width={width}
        height={height - 2}
      ></rect>
    </svg>
  </span>
  <span class="c-button-icon c-button-icon--before">
    <svg class="c-icon-arrow" width="28" height="28" viewBox="0 0 28 28">
      <g class="c-icon-arrow-shape" fill="currentColor">
        <rect rx="1" ry="1" x="11.3" y="11" width="2" height="2"></rect>
        <rect rx="1" ry="1" x="14.7" y="13" width="2" height="2"></rect>
        <rect rx="1" ry="1" x="11.3" y="15" width="2" height="2"></rect>
      </g>
      <line stroke="currentColor" stroke-dasharray="2 2" stroke-width="1" x1="28" y1="1" x2="28" y2="26"></line>
    </svg>
  </span>
  <span class="c-button-text">
    <span class="c-button-text-outer">
      <span class="c-button-text-inner">
        <span class="c-button-text-static">
          <span>{text}</span>
        </span>
        <span class="c-button-text-hover">
          <span>{text}</span>
        </span>
      </span>
    </span>
  </span>
  <span class="c-button-icon c-button-icon--after">
    <svg class="c-icon-arrow" width="28" height="28" viewBox="0 0 28 28">
      <g class="c-icon-arrow-shape" fill="currentColor">
        <rect rx="1" ry="1" x="11.3" y="11" width="2" height="2"></rect>
        <rect rx="1" ry="1" x="14.7" y="13" width="2" height="2"></rect>
        <rect rx="1" ry="1" x="11.3" y="15" width="2" height="2"></rect>
      </g>
      <line stroke="currentColor" stroke-dasharray="2 2" stroke-width="1" x1="0" y1="1" x2="0" y2="26"></line>
    </svg>
  </span>
</Tag>
